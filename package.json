{
  "name": "@ecommerce/contracts",
  "version": "1.1.1",
  "private": false,
  "files": [
    "proto",
    "dependencies",
    "generated",
    "dist",
    "descriptor.binpb"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./generated/*": {
      "types": "./dist/generated/*.d.ts",
      "require": "./dist/generated/*.js"
    }
  },
  "scripts": {
    "lint": "buf lint",
    "format": "buf format -w",
    "generate": "buf generate && protoc -I proto -I dependencies --include_imports --descriptor_set_out=descriptor.binpb $(find proto -name '*.proto')",
    "build": "npm run generate && tsc"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@grpc/grpc-js": "^1.14.4",
    "@nestjs/microservices": "^11.1.29",
    "rxjs": "^7.8.2"
  }
}
